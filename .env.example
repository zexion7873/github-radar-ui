# Notion internal integration token (starts with ntn_). Server-side only.
# 1. Create at https://www.notion.so/profile/integrations (Internal, capability: Read + Update content)
# 2. Share the four archive databases into it (Notion page -> ... -> Connections):
#    Trending Archive, Blog Archive, Loot Ledger (Claude Code), Loot Ledger (Copilot)
# 3. Copy this file to .env.local and paste the token below.
NOTION_TOKEN=

# App-level password gate (Vercel free tier can't password-protect production).
# APP_PASSWORD: the password you type to log in.
# AUTH_SECRET: a high-entropy random string — generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=
AUTH_SECRET=

# Optional: origin of the radar-rag (radar-intelligence-service) RAG service. When
# set, the home page shows an authed "問問雷達" box that asks it in natural language.
# Unset -> the box is hidden and the rest of the app is unaffected.
# RADAR_INTEL_URL=http://localhost:8080
